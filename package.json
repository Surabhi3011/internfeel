{
	"name": "internfeel",
	"version": "0.1.0",
	"private": true,
	"description": "InternFeel dev tools: WordPress Playground, wp-env and Playwright. Nothing here runs on the server.",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"playground": "wp-playground-cli server --wp=7.1 --php=8.5 --mount=./wp-content/themes/internfeel:/wordpress/wp-content/themes/internfeel --mount=./wp-content/plugins/internfeel-core:/wordpress/wp-content/plugins/internfeel-core --mount=./wp-content/mu-plugins/internfeel-hardening.php:/wordpress/wp-content/mu-plugins/internfeel-hardening.php --blueprint=./dev/blueprint.json --login",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:e2e": "playwright test --grep-invert @a11y",
		"test:a11y": "playwright test --grep @a11y",
		"test:unit": "wp-env run cli --env-cwd=internfeel-dev vendor/bin/phpunit"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.64.1",
		"@wordpress/env": "11.17.0",
		"@wp-playground/cli": "3.1.58"
	}
}
